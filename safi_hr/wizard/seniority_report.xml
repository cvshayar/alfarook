<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="joined_date_report_wizard_form" model="ir.ui.view">
            <field name="name">Seniority Report</field>
            <field name="model">seniority.report</field>
            <field name="arch" type="xml">
                <form string="">
                    <group>
                        <field name="report_type"/>
                        <field name="staff_type"/>
                        <field name="date"/>
                    </group>
                    <footer>
                        <button name="print_excel_report" string="Print Excel" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-default" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="joined_date_report_wizard_action" model="ir.actions.act_window">
            <field name="name">Seniority Report</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">seniority.report</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem
                id="employee_report_menu"
                name="Report"
                parent="hr.menu_hr_root"
                sequence="10"
        />

        <menuitem
                id="seniority_report_menu"
                name="Seniority Report"
                parent="safi_hr.employee_report_menu"
                sequence="0"
                action="joined_date_report_wizard_action"
        />

    </data>
</odoo>