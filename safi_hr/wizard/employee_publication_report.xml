<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="employee_publication_report_form" model="ir.ui.view">
            <field name="name">employee.publication.report.form</field>
            <field name="model">employee.publication.report</field>
            <field name="arch" type="xml">
                <form string="">
                    <group>
                        <field name="employee_ids" required="1" options="{'no_open': True, 'no_edit': True, 'no_create': True}"/>
                    </group>
                    <footer>
                        <button name="generate_report" string="Export" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-default" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="employee_publication_report_action" model="ir.actions.act_window">
            <field name="name">Employee Publication</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">employee.publication.report</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem id="report_menu_root"
                  name="Report"
                  sequence="10"
                  groups="safi_hr.group_employee_report"
                  web_icon="safi_hr,static/src/img/report.png"/>

        <menuitem id="employee_publication_report_menu"
                  name="Work Profile"
                  sequence="10"
                  parent="report_menu_root"
                  action="employee_publication_report_action"
        />


    </data>
</odoo>