<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="employee_id_card_form_view" model="ir.ui.view">
            <field name="name">employee.idcard.wizard.form</field>
            <field name="model">employee.idcard.wizard</field>
            <field name="arch" type="xml">
                <form string="Employee ID Card">
                    <group>
                        <field name="employee_ids"
                            options="{'no_create': True, 'no_open': True, 'no_edit': True}"/>
                        <field name="print"/>
                    </group>
                    <footer>
                        <button name="print_id_card" type="object" string="Preview"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="employee_id_card_act_window" model="ir.actions.act_window">
            <field name="name">ID Card Print</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">employee.idcard.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem name="Employee"
                  id="employee_id_card_menu_action"
                  parent="safi_students.id_card_menu_root"
                  action="employee_id_card_act_window"
                  sequence="10"
        />
    </data>
</odoo>