<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!--    Qualification Level    -->

        <record id="qualification_level_form_view" model="ir.ui.view">
            <field name="name">qualification.level.form</field>
            <field name="model">qualification.level</field>
            <field name="arch" type="xml">
                <form string="Qualification Level">
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="qualification_level_tree_view" model="ir.ui.view">
            <field name="name">qualification.level.tree</field>
            <field name="model">qualification.level</field>
            <field name="arch" type="xml">
                <tree string="Qualification Level">
                    <field name="name"/>
                </tree>
            </field>
        </record>

        <record id="qualification_level_act_window" model="ir.actions.act_window">
            <field name="name">Qualification Level</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">qualification.level</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Click here to add new Qualification Level.
                </p>
            </field>
        </record>

