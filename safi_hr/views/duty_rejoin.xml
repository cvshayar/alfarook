<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="duty_rejoin_form_view" model="ir.ui.view">
            <field name="name">duty.rejoin.form</field>
            <field name="model">duty.rejoin</field>
            <field name="arch" type="xml">
                <form string="Duty Rejoin">
                    <sheet>
                        <group>
                            <group>
                                <field name="employee_id" options="{'no_create': True, 'no_edit': True, 'no_open': True}" attrs="{'readonly': [('read_bool', '=', True)]}"/>
                                <field name="date" attrs="{'readonly': [('read_bool', '=', True)]}"/>
                                <field name="read_bool" invisible="1"/>
                            </group>
                            <group>
                                <field name="leave_id" options="{'no_create': True, 'no_edit': True}" attrs="{'readonly': [('read_bool', '=', True)]}" required="1"/>
                                <field name="duty_certificate_ids" widget="many2many_binary" attrs="{'readonly': [('read_bool', '=', True)]}"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="duty_rejoin_tree_view" model="ir.ui.view">
            <field name="name">duty.rejoin.tree</field>
            <field name="model">duty.rejoin</field>
            <field name="arch" type="xml">
                <tree string="Duty Rejoin">
                    <field name="employee_id"/>
                    <field name="date"/>
                </tree>
            </field>
        </record>

