<!--                    </group>-->
<!--                </search>-->
<!--            </field>-->
<!--        </record>-->

        <record id="duty_rejoin_act_window" model="ir.actions.act_window">
            <field name="name">Duty Rejoin</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">duty.rejoin</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">

                </p>
            </field>
        </record>

        <menuitem name="Duty Rejoin" id="duty_rejoin_menu" parent="hr_holidays.menu_hr_holidays_root" action="duty_rejoin_act_window"/>

    </data>
</odoo>