<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="email_employee_form_view" model="ir.ui.view">
            <field name="name">email.employee.form</field>
            <field name="model">email.employee</field>
            <field name="arch" type="xml">
                <form string="Email employee">
                    <header>
                        <button name="send_email" class="btn-primary" type="object" string="Send Email" states="draft"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                         <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" name="staff_view" type="object" icon="fa-list-ol"
                                    string="Employees"/>
                        </div>
                        <group>
                            <field name="subject" attrs="{'readonly': [('state', '=', 'sent')]}"/>
                            <field name="message" attrs="{'readonly': [('state', '=', 'sent')]}"/>
                            <field name="attachment" widget="many2many_binary" attrs="{'readonly': [('state', '=', 'sent')]}"/>
                            <field name="employee_type" attrs="{'readonly': [('state', '=', 'sent')]}"/>
                            <field name="department_ids" options="{'no_create': True, 'no_open': True, 'no_edit': True}" attrs="{'readonly': [('state', '=', 'sent')]}"/>
                            <field name="employee_ids" options="{'no_create': True, 'no_open': True, 'no_edit': True}" attrs="{'readonly': [('state', '=', 'sent')]}"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="email_employee_view_tree" model="ir.ui.view">
            <field name="name">email.employee.tree</field>
            <field name="model">email.employee</field>
            <field name="arch" type="xml">
                <tree string="email_employee_tree">
                    <field name="employee_type"/>
                    <field name="subject"/>
                    <field name="message"/>
                </tree>
            </field>
        </record>

        <record id="email_employee_act_window" model="ir.actions.act_window">
            <field name="name">Email employee</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">email.employee</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Click on create button
                </p>
            </field>
        </record>

        <record id="email_employee_line_view_form" model="ir.ui.view">
            <field name="name">email.employee.line.view.form</field>
            <field name="model">email.employee.line</field>
            <field name="arch" type="xml">
                <form string="Employees">
                    <sheet>
                        <group>
                            <field name="employee_id"/>
                            <field name="log_id"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="email_employee_line_tree" model="ir.ui.view">
            <field name="name">email.employee.line.tree</field>
            <field name="model">email.employee.line</field>
            <field name="arch" type="xml">
                <tree string="Employees">
                    <field name="employee_id"/>
                </tree>
            </field>
        </record>

        <menuitem name="Employee Communication"
                  id="message_employee_menu_root"
                  groups="base.group_user"
                  web_icon="safi_students,static/src/img/sms_odoo.png"/>

        <menuitem name="Send Email"
                  id="email_employee_action_menu"
                  action="email_employee_act_window"
                  parent="message_employee_menu_root"
                  groups="base.group_system"
                  sequence="5"
                  />
    </data>
</odoo>