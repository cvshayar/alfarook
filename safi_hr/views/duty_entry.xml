<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="hr_internal_duty_form_view" model="ir.ui.view">
            <field name="name">hr.internal.duty.form</field>
            <field name="model">hr.internal.duty</field>
            <field name="arch" type="xml">
                <form string="Internal Duty">
                    <header>
                        <field name="state" widget="statusbar"/>
                        <button name="confirm_duty" type="object" string="Confirm" states="draft" groups="safi_hr.group_internal_duty_entry"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="employee_id" required="1" attrs="{'readonly': [('state', '=', 'confirm')]}" options="{'no_create': True, 'no_open': True, 'no_edit': True}"/>
                            <field name="department_id" required="1" attrs="{'readonly': [('state', '=', 'confirm')]}" options="{'no_create': True, 'no_open': True, 'no_edit': True}"/>
                            <field name="duty_type_id" required="1" attrs="{'readonly': [('state', '=', 'confirm')]}" options="{'no_create': True, 'no_open': True, 'no_edit': True}"/>
                            <field name="date" required="1" attrs="{'readonly': [('state', '=', 'confirm')]}"/>
                            <field name="type" required="1" attrs="{'readonly': [('state', '=', 'confirm')]}"/>
                            <field name="hours" required="1" attrs="{'readonly': [('state', '=', 'confirm')]}"/>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="hr_internal_duty_tree_view" model="ir.ui.view">
            <field name="name">hr.internal.duty.tree</field>
            <field name="model">hr.internal.duty</field>
            <field name="arch" type="xml">
                <tree string="Internal Duty">
                    <field name="employee_id"/>
                    <field name="department_id"/>
                    <field name="duty_type_id"/>
                    <field name="date"/>
                    <field name="type"/>
                    <field name="hours"/>
                </tree>
            </field>
        </record>

        <record id="hr_internal_duty_search_view" model="ir.ui.view">
            <field name="name">hr.internal.duty.search</field>
            <field name="model">hr.internal.duty</field>
            <field name="arch" type="xml">
                <search string="Search Internal Duty">
                    <field name="employee_id" string="Employee"/>
                    <field name="department_id" string="Department"/>
                    <field name="duty_type_id" string="Duty Type"/>
                    <field name="date" string="Date"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter name="group_employee_id" string="Employee" context="{'group_by':'employee_id'}"/>
                        <filter name="group_department_id" string="Department" context="{'group_by':'department_id'}"/>
                        <filter name="duty_type_id" string="Duty Type" context="{'group_by':'duty_type_id'}"/>
                        <separator/>
                    </group>
                    <searchpanel>
                        <field name="department_id" string="Department" icon="fa-users"/>
                    </searchpanel>
                </search>
            </field>
        </record>

        <record id="hr_internal_duty_act_window" model="ir.actions.act_window">
            <field name="name">Internal Duty</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.internal.duty</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">

                </p>
            </field>
        </record>

        <!--    Duty Type    -->

        <record id="internal_duty_type_form_view" model="ir.ui.view">
            <field name="name">internal.duty.type.form</field>
            <field name="model">internal.duty.type</field>
            <field name="arch" type="xml">
                <form string="Internal Duty">
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="internal_duty_type_tree_view" model="ir.ui.view">
            <field name="name">internal.duty.type.tree</field>
            <field name="model">internal.duty.type</field>
            <field name="arch" type="xml">
                <tree string="Internal Duty">
                    <field name="name"/>
                </tree>
            </field>
        </record>

        <record id="internal_duty_type_act_window" model="ir.actions.act_window">
            <field name="name">Internal Duty Type</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">internal.duty.type</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">

                </p>
            </field>
        </record>

        <menuitem name="Duty Entry"
                  id="hr_internal_duty_menu"
                  web_icon="safi_hr,static/src/img/internal_duty.png"
                  action="hr_internal_duty_act_window"/>

        <menuitem name="Duty Type"
                  id="internal_duty_type_menu"
                  parent="hr_internal_duty_menu"
                  action="internal_duty_type_act_window"/>

    </data>
</odoo>