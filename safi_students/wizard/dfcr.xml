<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="dfcr_report_form" model="ir.ui.view">
            <field name="name">dfcr.wizard.form</field>
            <field name="model">dfcr.wizard</field>
            <field name="arch" type="xml">
                <form string="Choose your date">
                    <group>
                        <field name="from_date"/>
                        <field name="to_date"/>
                    </group>
                    <footer>

                        <button name="print_excel_report" string="Print" type="object"
                                class="btn-primary"/>
                        <button string="Cancel" class="btn-default" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        <record id="dfcr_report_action" model="ir.actions.act_window">
            <field name="name">DFCR</field>
            <field name="res_model">dfcr.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem name="DFCR"
                  action="dfcr_report_action"
                  id="dfcr_action_report_menu"
                  parent="fee_report_menu"
                  sequence="0"/>

        <!--    DFCR Self Finance    -->

        <record id="dfcr_self_finance_report_form" model="ir.ui.view">
            <field name="name">dfcr.self_finance.wizard.form</field>
            <field name="model">dfcr.self_finance.wizard</field>
            <field name="arch" type="xml">
                <form string="Choose your date">
                    <group>
                        <field name="from_date"/>
                        <field name="to_date"/>
                        <field name="receipt_mode"/>
                        <field name="report_type"/>
                    </group>
                    <footer>

                        <button name="print_excel_report" string="Print" type="object"
                                class="btn-primary"/>
                        <button string="Cancel" class="btn-default" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        <record id="dfcr_self_finance_report_action" model="ir.actions.act_window">
            <field name="name">DFCR Self</field>
            <field name="res_model">dfcr.self_finance.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem name="DFCR Self"
                  action="dfcr_self_finance_report_action"
                  id="dfcr_self_finance_action_report_menu"
                  parent="fee_report_menu"
                  sequence="0"/>
    </data>
</odoo>