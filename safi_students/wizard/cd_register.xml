<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="cd_register_wizard_form" model="ir.ui.view">
            <field name="name">cd.register.wizard.form</field>
            <field name="model">cd.register.wizard</field>
            <field name="arch" type="xml">
                <form string="CD Register">
                    <group>
                        <field name="year" required="1"/>
                        <field name="programme_type" required="1"/>
                    </group>
                    <footer>
                        <button name="generate_report" string="Generate" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-default" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="cd_register_wizard_action" model="ir.actions.act_window">
            <field name="name">CD Register Wizard</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">cd.register.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem
                id="fee_report_menu"
                name="Reports"
                parent="fees_root"
                sequence="6"
        />

        <menuitem
                id="cd_register_wizard_menu"
                name="CD Register"
                parent="fee_report_menu"
                sequence="6"
                action="cd_register_wizard_action"
        />
    </data>
</odoo>