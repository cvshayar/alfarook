<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="student_count_report_form" model="ir.ui.view">
            <field name="name">Student Count</field>
            <field name="model">student.count.report</field>
            <field name="arch" type="xml">
                <form string="Student Count">
                    <group>
                        <field name="to_date" required="1"/>
                        <field name="batch_year" required="1"/>
                        <field name="report_type" required="1"/>
                        <field name="level" required="0"/>
                        <field name="programme_ids" widget="many2many_tags"/>
                    </group>
                    <footer>
                        <button name="print_excel_report" string="Export" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-default" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="student_count_report_action" model="ir.actions.act_window">
            <field name="name">Student Count Report</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">student.count.report</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem
                id="student_count_report_menu"
                name="Student Count"
                parent="safi_students.student_report_menu"
                sequence="2"
                groups="group_student_user,group_student_manager"
                action="student_count_report_action"
        />
    </data>
</odoo>