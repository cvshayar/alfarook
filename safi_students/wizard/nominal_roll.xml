<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
       <record id="nominal_roll_form" model="ir.ui.view">
           <field name="name">nominal.roll.form</field>
           <field name="model">nominal.roll</field>
           <field name="arch" type="xml">
               <form string="Nominal roll">
                    <group>
                        <field name="year"/>
                        <field name="batch_ids" options="{'no_create': True, 'no_edit': True, 'no_open': True}" widget="many2many_tags"/>
                        <field name="second_language_ids" options="{'no_create': True, 'no_edit': True, 'no_open': True}" widget="many2many_tags"/>
                    </group>
                   <footer>
                        <button name="print_excel_report" string="Print Excel" type="object" class="btn-primary"/>
                        <button name="generate_report" string="Print" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-default" special="cancel"/>
                    </footer>
               </form>
           </field>
       </record>

        <record id="nominal_roll_action" model="ir.actions.act_window">
            <field name="name">Nominal Roll</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">nominal.roll</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <!-- This Menu Item must have a parent and an action -->
        <menuitem id="student_nominal_menu"
                  name="Nominal roll"
                  parent="student_report_menu"
                  action="nominal_roll_action"
                  groups="group_student_user,group_student_manager"
                  sequence="5"/>


    </data>
</odoo>