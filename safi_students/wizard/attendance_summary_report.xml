<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <record id="attendance_summary_report_form" model="ir.ui.view">
            <field name="name">attendance.summary.report.form</field>
            <field name="model">attendance.summary.report</field>
            <field name="arch" type="xml">
                <form string="Attendance Report">
                    <group>
                        <field name="from_date"/>
                        <field name="to_date"/>
                        <field name="start_year"/>
                        <field name="semester_id" options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                    </group>
                    <footer>
                        <button name="print_excel_report" string="Export" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-default" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="attendance_summary_report_action" model="ir.actions.act_window">
            <field name="name">Attendance Summary Report</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">attendance.summary.report</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem
                id="attendance_summary_report_menu"
                name="Attendance Summary Report"
                parent="attendance_report_menu"
                sequence="1"
                action="attendance_summary_report_action"
        />
        
    </data>
</odoo>