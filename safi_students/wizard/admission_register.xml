<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="student_admission_register_form" model="ir.ui.view">
            <field name="name">Admission Register</field>
            <field name="model">admission.register.report</field>
            <field name="arch" type="xml">
                <form string="Admission Register">
                    <group>
                        <field name="year_of_admission"/>
                        <field name="type" required="1"/>
                    </group>
                    <footer>
<!--                        <button name="print_excel_report" string="Print Excel" type="object" class="btn-primary"/>-->
                        <button name="generate_report" string="Print" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-default" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="student_admission_register_action" model="ir.actions.act_window">
            <field name="name">Admission Register</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">admission.register.report</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem
                id="student_report_menu"
                name="Report"
                parent="safi_students.student_root"
                sequence="3"
                groups="group_student_user,group_student_manager"
        />

        <menuitem
                id="student_admission_register_menu"
                name="Admission Register"
                parent="safi_students.student_report_menu"
                sequence="1"
                groups="group_student_user,group_student_manager"
                action="student_admission_register_action"
        />
    </data>
</odoo>