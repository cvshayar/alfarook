<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="programme_fee_collection_report_form" model="ir.ui.view">
            <field name="name">programme.fee.collection.report.form</field>
            <field name="model">programme.fee.collection.report</field>
            <field name="arch" type="xml">
                <form string="Choose your Month">
                    <group>
                        <field name="from_date"/>
                        <field name="to_date"/>
                        <field name="fee_type"/>
                        <field name="level"/>
                        <field name="year"/>
                        <field name="batch_ids" domain="[('programme_id.level', '=', level), ('start_year', '=', year)]"
                               options="{'no_create': True, 'no_edit': True, 'no_open': True}" widget="many2many_tags"/>
                    </group>
                    <footer>
                        <button name="print_excel_report" string="Print" type="object"
                                class="btn-primary"/>
                        <button string="Cancel" class="btn-default" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        <record id="programme_fee_collection_report_action" model="ir.actions.act_window">
            <field name="name">Fee Collection</field>
            <field name="res_model">programme.fee.collection.report</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem name="Fee Collection"
                  action="programme_fee_collection_report_action"
                  id="fee_collection_report_action_menu"
                  parent="fee_report_menu"
                  sequence="3"/>
    </data>
</odoo>