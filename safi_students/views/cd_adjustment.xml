<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="cd_adjustment_view_form" model="ir.ui.view">
            <field name="name">cd.adjustment.view.form</field>
            <field name="model">cd.adjustment</field>
            <field name="arch" type="xml">
                <form string="">
                    <header>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="student_id" options="{'no_create': True, 'no_open': True, 'no_edit': True}"/>
                                <field name="date"/>
                                <field name="amount"/>
                                <field name="refund_amount"/>
                                <field name="initiate_refund"/>
                                <field name="due_id"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="adjustment" string="Adjustment">
                                <field name="line_ids">
                                    <tree editable="bottom">
                                        <field name="due_id" force_save="1" readonly="1" invisible="1"/>
                                        <field name="fee_id" force_save="1" readonly="1" options="{'no_create': True, 'no_open': True, 'no_edit': True}"/>
                                        <field name="academic_year" force_save="1" readonly="1"/>
                                        <field name="semester_id" force_save="1" readonly="1" options="{'no_create': True, 'no_open': True, 'no_edit': True}"/>
                                        <field name="balance" force_save="1" readonly="1"/>
                                        <field name="amount"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="cd_adjustment_view_tree" model="ir.ui.view">
            <field name="name">cd.adjustment.view.tree</field>
            <field name="model">cd.adjustment</field>
            <field name="arch" type="xml">
                <tree string="">
                    <field name="student_id" />
                    <field name="date" />
                    <field name="amount" />
                </tree>
            </field>
        </record>

        <record id="cd_adjustment_action" model="ir.actions.act_window">
            <field name="name">CD Adjustment</field>
            <field name="res_model">cd.adjustment</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="help" type="html">
               <p></p>
            </field>
        </record>

        <menuitem
            id="cd_adjustment_menu"
            name="CD Adjustment"
            action="cd_adjustment_action"
            parent="fees_root"
            sequence="10"/>
    </data>
</odoo>
