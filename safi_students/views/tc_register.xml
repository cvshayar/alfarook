        <record id="tc_clearance_line_a4_form" model="ir.ui.view">
            <field name="name">tc.clearance.line.a4.form</field>
            <field name="model">tc.clearance.line</field>
            <field name="arch" type="xml">
                <form string="" create="false" delete="false">
                    <header>
                        <button name="print_application" type="object" icon="fa-print" class="btn btn-info"/>
                    </header>
                    <sheet>
                        <div class="row">
                            <div class="col-10">
                            </div>
                            <div class="col-2">
                                <field name="image" widget='image' class="oe_avatar"/>
                            </div>
                        </div>
                        <group>
                            <field name="clearance_id" force_save="1" invisible="1"/>
                            <field name="application_number"/>
                            <field name="student_name"/>
                            <field name="roll_no"/>
                            <field name="admission_number"/>
                            <field name="admission_year"/>
                            <field name="programme_id" options="{'no_create': True, 'no_open': True, 'no_edit': True}"/>
                            <field name="dues" force_save="1" readonly="1"/>
                            <field name="remarks" force_save="1" readonly="1"/>
                            <field name="section_id" force_save="1" invisible="1"/>
                            <field name="state" force_save="1" invisible="1"/>
                        </group>
                        <footer></footer>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="tc_clearance_line_form" model="ir.ui.view">
            <field name="name">tc.clearance.line.form</field>
            <field name="model">tc.clearance.line</field>
            <field name="arch" type="xml">
                <form string="" create="false" delete="false">
                    <header>
                        <button name="print_application" type="object" icon="fa-print" class="btn btn-info"/>
                        <button name="get_status" type="object" string="View status" class="btn btn-info"
