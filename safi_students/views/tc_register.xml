                            </div>
                        </div>
                        <group>
                            <field name="clearance_id" force_save="1" invisible="1"/>
                            <field name="application_number"/>
                            <field name="student_name"/>
                            <field name="roll_no"/>
                            <field name="admission_number"/>
                            <field name="admission_year"/>
                            <field name="programme_id" options="{'no_create': True, 'no_open': True, 'no_edit': True}"/>
                            <field name="dues"/>
                            <field name="remarks"/>
                            <field name="section_id" force_save="1" invisible="1"/>
                            <field name="state" force_save="1" invisible="1"/>
                            <field name="is_visible" invisible="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="tc_clearance_line_tree" model="ir.ui.view">
            <field name="name">tc.clearance.line.tree</field>
            <field name="model">tc.clearance.line</field>
            <field name="arch" type="xml">
                <tree string="" create="false" delete="false">
                    <field name="clearance_id"/>
                    <field name="student_name"/>
                    <field name="roll_no"/>
                    <field name="admission_number"/>
                    <field name="admission_year"/>
                    <field name="programme_id" options="{'no_create': True, 'no_open': True, 'no_edit': True}"/>
                    <field name="dues"/>
                    <field name="remarks"/>
                    <field name="state" force_save="1" invisible="1"/>
                </tree>
            </field>
        </record>

        <record id="tc_clearance_line_action" model="ir.actions.act_window">
            <field name="name">TC Clearance Line</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">tc.clearance.line</field>
            <field name="view_mode">tree,form</field>
            <field name="view_ids"
                   eval="[(5, 0, 0),
                          (0, 0, {'view_mode': 'tree', 'view_id': ref('tc_clearance_line_tree')}),
                          (0, 0, {'view_mode': 'form', 'view_id': ref('tc_clearance_line_form')})]"/>
            <field name="domain">[('section_id', '=', uid), ('state', '!=', 'issued')]</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    <!-- Add Text Here -->
                </p>
                <p>
                    <!-- More details about what a user can do with this object will be OK -->
                </p>
            </field>
        </record>

        <!--    TC Application Fetch    -->

        <record id="tc_application_wizard_form" model="ir.ui.view">
           <field name="name">Fetch TC Applications</field>
           <field name="model">tc.application.wizard</field>
           <field name="arch" type="xml">
               <form string="Fetch TC Applications">
                   <footer>
