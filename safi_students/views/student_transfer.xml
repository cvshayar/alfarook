<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="student_transfer_form_view_form" model="ir.ui.view">
            <field name="name">student.transfer.view.form</field>
            <field name="model">student.transfer</field>
            <field name="arch" type="xml">
                <form string="Student transfer">
                    <header>
                        <button string="Transfer" name="transfer_student" type="object" class="oe_highlight"
                                attrs="{'invisible': [('state','in',('transferred'))]}"/>
                        <field name="state" widget="statusbar" nolabel="1" statusbar_visible="draft,transferred"/>
                    </header>
                        <h1 class="mt0">
                            <div>
                                <label for="name" string="Transfer sequence"
                                       attrs="{'invisible': [('state','in',('transferred'))]}"/>
                                <field name="name" readonly="1" class="oe_inline"
                                       attrs="{'invisible': [('state','in',('draft'))]}"/>
                            </div>
                        </h1>
                        <group>
                            <field name="student_id" options="{'no_create': True, 'no_open': True, 'no_edit': True}"/>
                            <field name="admission_number"/>
<!--                            <field name="student"/>-->
                            <field name="from_batch_id" options="{'no_create': True, 'no_open': True, 'no_edit': True}"/>
                            <field name="to_batch_id" options="{'no_create': True, 'no_open': True, 'no_edit': True}"/>
                            <field name="transferred_date"/>
                        </group>
                        <group>
                            <field name="remarks"/>
                            <field name="new_student_id" force_save="1" invisible="1"/>
                        </group>
<!--                    </sheet>-->
                </form>
            </field>
        </record>

        <record id="student_transfer_view_tree" model="ir.ui.view">
            <field name="name">student.transfer.view.tree</field>
            <field name="model">student.transfer</field>
            <field name="arch" type="xml">
                <tree string="Student transfer">
                    <field name="name"/>
                    <field name="admission_number"/>
                    <field name="student_id"/>
                    <field name="from_batch_id"/>
                    <field name="to_batch_id"/>
                    <field name="transferred_date"/>
                </tree>
            </field>
        </record>

        <record id="student_transfer_action" model="ir.actions.act_window">
            <field name="name">Student Transfer</field>
            <field name="res_model">student.transfer</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    <!-- Add Text Here -->
                </p>
                <p>
                    <!-- More details about what a user can do with this object will be OK -->
                </p>
            </field>
        </record>

        <menuitem
                id="student_transfer_root_menu"
                name="Student Transfer"
                web_icon="safi_students,static/src/img/icon_transfer.png"
                sequence="4"
                groups="safi_students.group_transfer_user,safi_students.group_transfer_manager"/>

        <menuitem
                id="student_transfer_parent_menu"
                name="Student Transfer"
                parent="student_transfer_root_menu"
                sequence="1"/>

        <menuitem
                id="student_transfer_menu"
                name="Student Transfer"
                action="student_transfer_action"
                parent="student_transfer_parent_menu"
                sequence="1"/>
    </data>
</odoo>