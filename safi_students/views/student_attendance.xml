<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="course_view_form" model="ir.ui.view">
            <field name="name">course_view_form</field>
            <field name="model">course.course</field>
            <field name="arch" type="xml">
                <form string="_form">
                    <sheet>
                        <group>
                            <field name="complete_name"/>
                            <field name="code" required="1"/>
                            <field name="name" required="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="course_view_tree" model="ir.ui.view">
            <field name="name">course_view_tree</field>
            <field name="model">course.course</field>
            <field name="arch" type="xml">
                <tree string="course_tree">
                    <field name="name"/>
                    <field name="code"/>
                </tree>
            </field>
        </record>
    
    	<record id="course_search" model="ir.ui.view">
           <field name="name">course.course.search</field>
           <field name="model">course.course</field>
            <field name="arch" type="xml">
                <search string="">
                    <field name="name" string="Course"/>
                	<field name="code" string="Code"/>
            </search>
           </field>
        </record>

        <record id="course_action" model="ir.actions.act_window">
            <field name="name">Course</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">course.course</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!--    Curriculum    -->

        <record id="curriculum_view_form" model="ir.ui.view">
            <field name="name">curriculum_view_form</field>
            <field name="model">curriculum.curriculum</field>
            <field name="arch" type="xml">
                <form string="curriculum_form">
                    <sheet>
                        <group>
                            <field name="name" required="1"/>
<!--                            <field name="batch_id" required="1" options="{'no_create': True, 'no_open': True, 'no_edit': True}"/>-->
                            <field name="programme_ids" widget="many2many_tags" required="1" options="{'no_create': True, 'no_open': True, 'no_edit': True}"/>
                            <field name="year" required="1"/>
                            <field name="semester_id" required="1" options="{'no_create': True, 'no_open': True, 'no_edit': True}"/>
                            <field name="course_ids" required="1" options="{'no_create': True, 'no_open': True, 'no_edit': True}"/>
                        </group>
<!--                        <notebook>-->
<!--                            <page name="Course" string="Course">-->
<!--                                <field name="curriculum_line_ids" required="1">-->
<!--                                    <tree editable="bottom">-->
<!--                                        <field name="course_id" options="{'no_create': True, 'no_open': True, 'no_edit': True}"/>-->
<!--                                    </tree>-->
<!--                                </field>-->
<!--                            </page>-->
<!--                        </notebook>-->
                    </sheet>
                </form>
            </field>
        </record>

        <record id="curriculum_view_tree" model="ir.ui.view">
            <field name="name">curriculum_view_tree</field>
            <field name="model">curriculum.curriculum</field>
            <field name="arch" type="xml">
                <tree string="curriculum_tree">
                    <field name="name"/>
                    <field name="programme_ids" widget="many2many_tags"/>
                    <field name="year"/>
<!--                    <field name="batch_id"/>-->
                    <field name="semester_id"/>
                </tree>
            </field>
        </record>

        <record id="curriculum_action" model="ir.actions.act_window">
            <field name="name">Curriculum</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">curriculum.curriculum</field>
            <field name="view_mode">tree,form</field>
        </record>


        <menuitem id="student_attendance_root_menu" name="Attendance" sequence="10" web_icon="safi_students,static/src/img/Attendance.png"/>
        <menuitem name="Curriculum" id="curriculum_menu" parent="student_attendance_root_menu" action="curriculum_action" sequence="2"/>
        <menuitem name="Course" id="course_menu" parent="student_attendance_root_menu" action="course_action" sequence="3"/>
    </data>
</odoo>